# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API

# Browser-safe: Next.js client bundle'a girer (NEXT_PUBLIC_ prefix zorunlu)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: NEXT_PUBLIC_ prefix OLMAZ. src/lib/supabase/server.ts dışında kullanılmaz.
# Bu değer hiçbir client component, hook veya browser bundle'a girmemelidir.
SUPABASE_SERVICE_ROLE_KEY=

# Direct DB bağlantısı — yalnızca migration araçları için (psql, supabase db push vb.)
# Uygulama kodu bu değişkeni kullanmaz.
SUPABASE_DATABASE_URL=

# ─── Site ────────────────────────────────────────────────────────────────────
# Geliştirme:  http://localhost:3000
# Canlı:       https://[TODO_CLIENT_DOMAIN]
NEXT_PUBLIC_SITE_URL=

# ─── SMTP (Mail) ─────────────────────────────────────────────────────────────
# Server-only: asla NEXT_PUBLIC_ yapma, asla client bundle'a gönderme.
# Mail metadata (from_name, from_email) → Admin → Ayarlar → Mail sekmesi

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── WooCommerce Migration (Phase 6 — temporary, revoke after import) ─────────
# WooCommerce → Settings → Advanced → REST API
# Permission: READ ONLY — Description: "PITT Migration"
# NEVER commit real keys. Remove from .env.local after migration is complete.

WOOCOMMERCE_SOURCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
